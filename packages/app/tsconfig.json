{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@folkcare/core": ["../core/dist/index.d.ts"],
      "@folkcare/core/*": ["../core/dist/*"],
      "@folkcare/*": ["../../verticals/*/dist/index.d.ts"]
    }
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "replacers": {
      "replace-imports": {
        "replace": "^(\\.{1,2}\\/[^'\"]+)$",
        "with": "$1.js"
      }
    }
  },
  "include": [
    "src/**/*",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../../verticals/caregiver-staff"
    }
  ]
}
