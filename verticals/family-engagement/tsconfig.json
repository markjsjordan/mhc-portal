{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@folkcare/core": ["../../packages/core/dist/index.d.ts"],
      "@folkcare/core/*": ["../../packages/core/dist/*"],
      "@folkcare/client-demographics": ["../../verticals/client-demographics/dist/index.d.ts"],
      "@folkcare/care-plans-tasks": ["../../verticals/care-plans-tasks/dist/index.d.ts"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "references": [
    {
      "path": "../../packages/core"
    }
  ],
  "tsc-alias": {
    "resolveFullPaths": true,
    "replacers": {
      "replace-imports": {
        "replace": "^(\\.{1,2}\\/[^'\"]+)$",
        "with": "$1.js"
      }
    }
  }
}
