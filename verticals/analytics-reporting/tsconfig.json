{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@folkcare/core": [
        "../../packages/core/dist/index.d.ts"
      ],
      "@folkcare/core/*": [
        "../../packages/core/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/__tests__/**"
  ],
  "references": [
    {
      "path": "../../packages/core"
    }
  ],
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false,
    "replacers": {
      "pathsToModuleNameMapper": [
        {
          "pattern": "^(\\.{1,2}\\/[^'\"]+)$",
          "replace": "$1.js"
        }
      ]
    }
  }
}
